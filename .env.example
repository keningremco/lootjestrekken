# Kopieer dit bestand naar .env en pas de waarden aan

# MySQL/MariaDB (de database zelf moet al bestaan, de tabellen maakt de app aan)
DATABASE_URL=mysql+pymysql://gebruiker:wachtwoord@localhost:3306/lootjes
# Postgres:  postgresql+psycopg2://gebruiker:wachtwoord@localhost:5432/lootjes
# SQLite:    sqlite:///lootjes.db

# Lange willekeurige tekst, bv. te maken met: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=verander-mij

# Wachtwoord voor het beheerdersportaal (/admin)
ADMIN_PASSWORD=verander-mij-ook
